# Copy to .env and fill in values. Never commit .env.

# Application
NEXUS_ENVIRONMENT=development
NEXUS_LOG_LEVEL=INFO
NEXUS_CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL (shared by docker-compose and the backend)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=
POSTGRES_DB=nexus

# LLM (Phase 3). "none" disables planning/agent endpoints (503).
# Providers: none | anthropic | openai (any OpenAI-compatible endpoint).
NEXUS_LLM_PROVIDER=none
NEXUS_LLM_MODEL=claude-opus-5
# Only needed with NEXUS_LLM_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
NEXUS_LLM_TIMEOUT_SECONDS=60
NEXUS_LLM_MAX_RETRIES=1
# Max output tokens per call; lower it if the model's limit is smaller.
NEXUS_LLM_MAX_TOKENS=16000
# OpenAI-compatible provider (NEXUS_LLM_PROVIDER=openai). NEXUS_LLM_MODEL must be set to
# the endpoint's model id. Never commit a real key.
OPENAI_API_KEY=
# e.g. https://your-endpoint.example/v1 ; empty = api.openai.com
OPENAI_BASE_URL=
# json_schema (default) | json_object (servers without JSON-schema support)
NEXUS_OPENAI_RESPONSE_FORMAT=json_schema
# Strict json_schema: auto (strict; optional fields sent as required+nullable and the
# nulls removed again before validation) | true | false (never strict)
NEXUS_OPENAI_STRICT_SCHEMA=auto
# max_tokens (default) | max_completion_tokens (required by some reasoning models)
NEXUS_OPENAI_MAX_TOKENS_PARAM=max_tokens
NEXUS_AGENT_TIMEOUT_SECONDS=180
NEXUS_MAX_PLANNED_TASKS=10

# Tools (Phase 4). See docs/tool-model.md.
NEXUS_MAX_TOOL_CALLS_PER_TASK=5
# Real outbound HTTP for agents (SSRF-guarded). Off by default.
NEXUS_HTTP_FETCH_ENABLED=false
NEXUS_HTTP_FETCH_MAX_BYTES=262144
NEXUS_HTTP_FETCH_MAX_TIMEOUT_SECONDS=15
NEXUS_SPECIALIST_TOOLS=["calculator", "artifact_write"]
NEXUS_TOOL_OUTPUT_MAX_CHARS=20000

# --- Artifacts (Phase 10; see docs/artifact-model.md) ------------------------------------
# Generated files and project ZIPs live in a controlled workspace under this directory
# (relative to the working directory). The specialist needs "artifact_write" in
# NEXUS_SPECIALIST_TOOLS to create them.
NEXUS_ARTIFACTS_ENABLED=true
NEXUS_ARTIFACT_ROOT=var/artifacts
NEXUS_ARTIFACT_MAX_FILES=200
NEXUS_ARTIFACT_MAX_FILE_BYTES=1000000
NEXUS_ARTIFACT_MAX_TOTAL_BYTES=20000000
NEXUS_ARTIFACT_MAX_ZIP_BYTES=20000000
NEXUS_ARTIFACT_MAX_PATH_LENGTH=200
NEXUS_ARTIFACT_MAX_PATH_DEPTH=10
NEXUS_ARTIFACT_MAX_PER_TASK=5

# Recovery (Phase 5). See docs/recovery-model.md.
# Replanner invocations allowed per run (accepted + rejected); 0 disables recovery.
NEXUS_MAX_REPLANS_PER_RUN=2

# Conflicts (Phase 6). See docs/conflict-model.md.
# Resolution tasks per run; 0 = detect and record conflicts only.
NEXUS_MAX_CONFLICT_RESOLUTIONS_PER_RUN=5

# Policy gate (Phase 8). See docs/policy-model.md. Outcome per category:
# allow | approval_required | deny  (read_only is always allowed)
NEXUS_POLICY_NETWORK_READ=allow
NEXUS_POLICY_REVERSIBLE_WRITE=allow
NEXUS_POLICY_IRREVERSIBLE=approval_required
# Tools always denied / always requiring approval (JSON lists of tool names).
NEXUS_POLICY_DENIED_TOOLS=[]
NEXUS_POLICY_APPROVAL_TOOLS=[]

# Orchestration (Phase 9). See docs/orchestration-model.md.
# The final checkpoint also asks the LLM verifier (only when an LLM is in use).
NEXUS_VERIFICATION_SEMANTIC=true
# Upper bound on scheduler passes per /execute call.
NEXUS_MAX_ORCHESTRATION_PASSES=10

# --- Role-based LLM routing ------------------------------------------------------------
# See docs/llm-routing.md. Each role can use a different provider/model; routing is
# deterministic configuration, never a model decision. Unset role = the default provider
# above (NEXUS_LLM_PROVIDER / NEXUS_LLM_MODEL, e.g. the Navigate Labs endpoint).
# Providers: default | gemini | openrouter | groq. A provider's API key is required only if a
# role is routed to it. Never commit real keys.
#
# Models: free at the time this configuration was selected (2026-10-04);
# availability/rate limits are provider-controlled. OpenRouter :free models: 20 req/min,
# 50 req/day (1,000/day after $10 of purchased credits). Gemini free tier: content may
# be used to improve Google's products; limits are shown in AI Studio.
NEXUS_GEMINI_API_KEY=
NEXUS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
NEXUS_OPENROUTER_API_KEY=
NEXUS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NEXUS_GROQ_API_KEY=
NEXUS_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Planner: task-graph reasoning + strict schema adherence. Groq gpt-oss-120b: production
# model; Groq documents strict json_schema for it (anyOf, $defs, nullable, enums); free
# plan 30 req/min, 1K req/day, 8K tokens/min, 200K tokens/day (selected 2026-10-04).
NEXUS_PLANNER_PROVIDER=groq
NEXUS_PLANNER_MODEL=openai/gpt-oss-120b
# Researcher: tool use via structured JSON steps + provenance discipline. Nemotron 3
# Super 120B-A12B (OpenRouter free): built for multi-agent applications; supports
# structured_outputs + response_format; 262k context.
# NEXUS_RESEARCHER_PROVIDER=openrouter
# NEXUS_RESEARCHER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
NEXUS_RESEARCHER_PROVIDER=gemini
NEXUS_RESEARCHER_MODEL=gemini-3.5-flash-lite

# Analyst: reasoning over facts + structured output, with calculator steps. Gemini 3.5
# Flash-Lite: real-tested in NEXUS 2026-10-06 (valid calculator call_tool step, then finish,
# tool provenance accepted). Was qwen/qwen3.8-27b:free, which OpenRouter no longer lists
# (HTTP 404); the same model on Groq returns empty call_tool steps.
NEXUS_ANALYST_PROVIDER=gemini
NEXUS_ANALYST_MODEL=gemini-3.5-flash-lite
# Specialist: straightforward deliverables, low latency. Gemini 3.5 Flash-Lite: stable,
# fastest/lightest current free Gemini text model.
NEXUS_SPECIALIST_PROVIDER=gemini
NEXUS_SPECIALIST_MODEL=gemini-3.5-flash-lite
# Conflict resolver: fetch independent evidence + compare provenance. Gemini 3.5 Flash-Lite
# (same model as the analyst and specialist): real-tested in NEXUS 2026-10-06 end to end
# (one http_fetch of an undisputed source, no repeated call, tool-derived claim on the exact
# subject/attribute, original facts kept, ConflictResolved). Failed real tests: Groq gpt-oss
# (native tool calls), Groq qwen3.8-27b (empty call_tool step), Nemotron 3 Super (repeated
# the same fetch instead of finishing); Gemini 3.5 Flash returned 503; OpenRouter
# qwen3.8-27b:free was removed (404). The verdict itself is deterministic and requires tool
# evidence independent of the disputed sources.
NEXUS_CONFLICT_RESOLVER_PROVIDER=gemini
NEXUS_CONFLICT_RESOLVER_MODEL=gemini-3.5-flash-lite
# Replanner: graph edits under the planner's deterministic gates. Groq gpt-oss-20b
# (spreads load: Groq limits are per model).
NEXUS_REPLANNER_PROVIDER=groq
NEXUS_REPLANNER_MODEL=openai/gpt-oss-20b
# Verifier: independent, evidence-based judgment. Groq gpt-oss-120b: different from every
# model that produces evidence (researcher, analyst, specialist, conflict resolver), so
# no worker grades its own output. (Gemini 3.8 Flash returned 503.)
NEXUS_VERIFIER_PROVIDER=groq
NEXUS_VERIFIER_MODEL=openai/gpt-oss-120b
